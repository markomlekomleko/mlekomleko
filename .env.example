# Local application -----------------------------------------------------------
APP_ENV=local
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIME_ZONE=Europe/Belgrade
SESSION_SECRET=replace-with-at-least-32-random-bytes
MAGIC_LINK_SECRET=replace-with-a-different-random-secret
MAGIC_LINK_TTL_MINUTES=15
DELIVERY_EDIT_CUTOFF_HOURS=24
# Server-only admin login. Configure both in Vercel Preview and Production.
# Password must contain at least 10 characters. Never use NEXT_PUBLIC_* names.
# Changing either value and redeploying invalidates all previous admin sessions.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Separate secret used by Vercel Cron (Authorization: Bearer ...).
CRON_SECRET=
# Raw magic-link tokens are returned automatically only to loopback requests.
LOCAL_AUTH_EXPOSE_TOKEN=false
# Customer registration and one-time codes. Local mode NEVER sends messages;
# codes are exposed only on loopback, outside production/Vercel.
# Production: AUTH_MODE=provider and a random AUTH_CODE_SECRET of >=32 characters.
AUTH_MODE=local
AUTH_CODE_SECRET=

# Database -------------------------------------------------------------------
# Supabase/PostgreSQL takes precedence when configured. Server-only values.
# POSTGRES_URL=postgres://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Never put connection passwords into NEXT_PUBLIC_* variables.
# Optional schema override is used only by isolated PostgreSQL tests.
# POSTGRES_SCHEMA=public
# Local SQLite. Never use a file URL on Vercel.
DATABASE_URL=file:.data/mleko.sqlite
# On Vercel set TURSO_DATABASE_URL=libsql://... and TURSO_AUTH_TOKEN in the
# project environment; keep both unset locally to use DATABASE_URL above.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Safety latch. Leave false for all local development and tests.
ALLOW_PRODUCTION_INTEGRATIONS=false

# Card payments ---------------------------------------------------------------
# Provider is unresolved in the brief. Choose exactly one: disabled | otp |
# raiaccept. Do not combine OTP and RaiAccept credentials or callback formats.
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_BASE_URL=
PAYMENT_API_SECRET=
# Required even for the local mock callback; never reuse the admin secret.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:3000/checkout/rezultat

# Badi fiscalization ----------------------------------------------------------
# disabled | mock | sandbox | production | local
BADI_MODE=mock
BADI_API_KEY=
BADI_API_SECRET=
BADI_CLIENT_ID=
# Badi SKU se unosi uz svaki proizvod u administraciji.
BADI_DELIVERY_SKU=
BADI_ADJUSTMENT_SKU=
# Used only for BADI_MODE=local. Local Badi has no auth, so keep it loopback-only.
BADI_LOCAL_BASE_URL=http://127.0.0.1:9999

# Transactional notifications ------------------------------------------------
# provider supports infobip or resend. For Infobip, use your verified email domain.
EMAIL_MODE=console
EMAIL_PROVIDER=infobip
EMAIL_API_KEY=
EMAIL_FROM="Mleko i Mleko <noreply@example.com>"

# disabled | queue | provider. Queue keeps WhatsApp-ready events local.
WHATSAPP_MODE=queue
WHATSAPP_PROVIDER=infobip
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=
# Account-specific origin from Infobip portal, e.g. https://xxxxx.api.infobip.com
INFOBIP_BASE_URL=
# Use the exact APPROVED template names and language from your Infobip portal.
WHATSAPP_AUTH_TEMPLATE=mm_login_code
WHATSAPP_TEMPLATE_LANGUAGE=sr
# Optional utility template, fixed text + STATIC button linking to https://YOUR_DOMAIN/nalog.
# Leave blank until approved. Notifications additionally require customer consent.
WHATSAPP_UPDATE_TEMPLATE=

# Analytics -------------------------------------------------------------------
# Public IDs are intentionally blank locally. Consent defaults to denied.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_ADS_CONVERSION_ID=

# Optional observability ------------------------------------------------------
LOG_LEVEL=debug
ERROR_REPORTING_DSN=
